credentials/*.json
credentials/*.enc
credentials/*.token
credentials/store*
.env
*.key
*.pem

# runtime data / logs / db
data/
*.log
*.db
*.sqlite

# os
.DS_Store

# build artefacts (the release checklist builds on an exported copy; this is for anyone who builds in place)
dist/
build/
