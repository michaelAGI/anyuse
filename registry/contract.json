{
  "contract": "anyuse.registry/0",
  "schema": "anyuse.map/0",
  "note": [
    "THE ONE CONTRACT both sides read: registry/schema.py (Python client, exporter,",
    "reference server) and registry/worker/src/validate.js (Cloudflare Worker).",
    "Patterns are written in the common subset of Python re and JavaScript RegExp",
    "and are always applied to the WHOLE string (Python re.fullmatch, JS ^...$).",
    "Every string in an entry is printable ASCII; that keeps the canonical JSON",
    "(sorted keys, no whitespace) byte-identical on both sides."
  ],
  "limits": {
    "max_body_bytes": 65536,
    "max_capabilities": 32,
    "max_params": 8,
    "max_template_chars": 512,
    "max_string_chars": 512,
    "max_idnames": 16,
    "max_binds": 8,
    "max_fresh_inputs": 50,
    "max_search_query_chars": 64,
    "max_list_results": 50
  },
  "enums": {
    "target_kind": ["web", "desktop"],
    "capability_kind": ["search", "detail", "page", "filter", "sort", "app_operator", "desktop_class"],
    "web_kinds": ["search", "detail", "page", "filter", "sort"],
    "desktop_kinds": ["app_operator", "desktop_class"],
    "param_type": ["string", "integer"],
    "param_where_web": ["query", "path"],
    "param_where_desktop": ["input"],
    "proof_status": ["proved", "discovered", "refused", "unproved"],
    "proof_kind": ["learn", "sort", "desktop", "none"],
    "desktop_class": ["arithmetic", "file_write", "directory_op", "file_search", "read_value"],
    "desktop_subtype": ["create", "rename"],
    "request_method": ["GET"]
  },
  "patterns": {
    "origin": "https://[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*\\.[a-z][a-z0-9-]{0,61}[a-z0-9]",
    "app": "[A-Za-z0-9][A-Za-z0-9 .+&()-]{0,63}",
    "app_id": "[a-z][a-z0-9-]{0,62}(\\.[A-Za-z0-9][A-Za-z0-9-]{0,62}){1,6}",
    "version": "[0-9]{1,4}(\\.[0-9]{1,5}){0,3}",
    "capability_name": "[a-z][a-z0-9_]{0,47}",
    "param_name": "[a-z][a-z0-9_]{0,31}",
    "query_key": "[A-Za-z0-9_.\\[\\]-]{1,40}",
    "fixed_value": "[A-Za-z0-9._-]{0,32}",
    "path_literal": "[A-Za-z0-9._~-]{1,64}",
    "idname": "[A-Z][A-Z0-9]{0,31}_OT_[a-z0-9_]{1,63}",
    "kwarg": "[a-z_][a-z0-9_]{0,47}",
    "date": "20[0-9]{2}-[01][0-9]-[0-3][0-9]",
    "anyuse_version": "[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}([a-z]{1,5}[0-9]{0,3})?",
    "content_hash": "[0-9a-f]{64}",
    "map_id": "[0-9a-f]{32}",
    "key_id": "[a-z0-9][a-z0-9_-]{2,39}",
    "nonce": "[0-9a-f]{32}",
    "public_key": "[A-Za-z0-9_-]{43}",
    "private_key": "[A-Za-z0-9_-]{43}",
    "signature": "[A-Za-z0-9_-]{86}",
    "printable_ascii": "[ -~]*"
  },
  "forbidden_query_keys": [
    "redirect", "redirect_uri", "redirect_url", "redirecturl", "return", "returnto",
    "return_to", "returnurl", "return_url", "next", "url", "uri", "goto", "to", "dest",
    "destination", "continue", "callback", "cb", "target", "link", "out",
    "token", "access_token", "id_token", "refresh_token", "auth", "authorization",
    "key", "api_key", "apikey", "secret", "client_secret", "password", "passwd", "pass",
    "pwd", "session", "sessionid", "session_id", "sid", "phpsessid", "jsessionid",
    "cookie", "csrf", "csrf_token", "xsrf", "signature", "sig", "code", "state", "otp",
    "email", "mail", "user", "username", "userid", "user_id", "uid", "account",
    "account_id", "accountid", "customer", "customer_id", "tenant", "tenant_id", "phone"
  ],
  "forbidden_substrings": [
    "/users/", "/home/", "/private/", "/var/folders/", "c:\\", "\\\\", "@", "bearer ",
    "cookie", "set-cookie", "authorization", "://localhost", "127.0.0.1",
    "file:", "data:", "javascript:", "%2f", "%40", "%3a"
  ],
  "forbidden_keys_extra": [
    "values", "alt_values", "evidence", "preview", "title", "first_url", "learned_url",
    "ground_truth_sample", "binding", "headers", "cookies", "cookie", "body", "html",
    "recording", "har", "dom", "page", "pages", "screenshot", "token", "secret",
    "password", "account_id", "user", "path", "file", "home"
  ],
  "never_travels_snapshot": [
    "full_guide", "short_description", "use_cases", "ui_landmarks",
    "navigation_tips", "common_tasks", "successful_patterns", "known_issues",
    "user_activities", "agent_activities", "linked_workflows",
    "common_shortcuts", "required_elements", "url_patterns", "title_patterns",
    "custom_render_notes", "domain", "bundle_id", "app_aliases",
    "ax_path", "js_selector", "description", "command", "implementations",
    "screenshot", "visual_anchor", "anchors", "filename", "image", "png",
    "created_at", "updated_at", "last_seen", "last_executed",
    "last_failure_reason", "timestamp"
  ],
  "trust": {
    "verified_min_distinct_contributors": 2,
    "verified_counts_status": "proved",
    "client_trusts_verified": false,
    "pulled_status": "unproved"
  },
  "auth": {
    "alg": "ed25519",
    "header_alg": "X-AnyUse-Sig-Alg",
    "header_key": "X-AnyUse-Key",
    "header_timestamp": "X-AnyUse-Timestamp",
    "header_nonce": "X-AnyUse-Nonce",
    "header_signature": "X-AnyUse-Signature",
    "max_skew_s": 300,
    "string_to_sign": "METHOD\\nPATH_WITH_QUERY\\nTIMESTAMP\\nNONCE\\nSHA256HEX(BODY)"
  },
  "rate_limits": {
    "writes_per_key_per_hour": 30
  },
  "routes": [
    {"method": "POST", "path": "/v0/maps", "auth": true},
    {"method": "GET", "path": "/v0/maps", "query": ["target"], "auth": false},
    {"method": "GET", "path": "/v0/maps/{id}", "auth": false},
    {"method": "POST", "path": "/v0/maps/{id}/proofs", "auth": true},
    {"method": "GET", "path": "/v0/search", "query": ["q"], "auth": false}
  ],
  "errors": {
    "bad_json": 400,
    "schema": 422,
    "too_large": 413,
    "hash_mismatch": 422,
    "unauthorized": 401,
    "replay": 401,
    "rate_limited": 429,
    "not_found": 404,
    "method_not_allowed": 405,
    "bad_query": 400
  }
}
